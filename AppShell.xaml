<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WeatherAPP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:WeatherAPP.Views"
    xmlns:viewmodels="clr-namespace:WeatherAPP.ViewModels"
    Shell.FlyoutBehavior="Disabled"
    Title="WeatherAPP">

    <TabBar>
        <Tab Title="Погода" Icon="weather.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:CurrentWeatherPage}"
                Route="CurrentWeather" />
        </Tab>
        
        <Tab Title="Прогноз" Icon="forecast.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:ForecastPage}"
                Route="Forecast" />
        </Tab>
        
        <Tab Title="Настройки" Icon="settings.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="Settings" />
        </Tab>
    </TabBar>

</Shell>
