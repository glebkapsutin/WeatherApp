<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherAPP.Views.ForecastPage"
             BackgroundColor="{Binding BackgroundColor}">

    <ContentPage.Resources>
        <Style x:Key="CardStyle" TargetType="Frame">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BackgroundColor" Value="{Binding CardBackgroundColor}" />
            <Setter Property="HasShadow" Value="True" />
            <Setter Property="BorderColor" Value="Transparent" />
        </Style>
        
        <Style x:Key="HeaderStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{Binding TextColor}" />
        </Style>
        
        <Style x:Key="SubHeaderStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{Binding TextColor}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        
        <Style x:Key="TemperatureStyle" TargetType="Label">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{Binding TextColor}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="16">
        <!-- Заголовок и ввод -->
        <VerticalStackLayout Grid.Row="0" Spacing="16">
            <Label Text="Прогноз погоды"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{Binding TextColor}"
                   HorizontalOptions="Center"
                   Margin="0,8,0,16" />
                   
            <Frame Padding="8" CornerRadius="8" 
                   BackgroundColor="{Binding CardBackgroundColor}"
                   BorderColor="Transparent"
                   HasShadow="True">
                <Grid ColumnDefinitions="*,Auto" Margin="8">
                    <Entry Grid.Column="0" 
                           Placeholder="Введите город" 
                           Text="{Binding CityName}"
                           TextColor="{Binding TextColor}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                    
                    <Button Grid.Column="1" 
                            Text="Прогноз"
                            Command="{Binding GetForecastCommand}"
                            CornerRadius="20"
                            Margin="8,0,0,0"
                            HeightRequest="40"
                            VerticalOptions="Center" />
                </Grid>
            </Frame>
            
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding IsErrorVisible}"
                   TextColor="Red"
                   Margin="8,0" />
        </VerticalStackLayout>
        
        <!-- Прогноз погоды -->
        <ScrollView Grid.Row="1" Margin="0,16,0,0">
            <CollectionView ItemsSource="{Binding ForecastDays}" 
                          EmptyView="Нет данных о прогнозе">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardStyle}">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12">
                                <!-- Дата и день недели -->
                                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Label Text="{Binding DateString, StringFormat='{0:dd MMM}'}" 
                                           Style="{StaticResource HeaderStyle}" />
                                    <Label Text="•" 
                                           Style="{StaticResource SubHeaderStyle}" />
                                    <Label Text="{Binding DateString}" 
                                           Style="{StaticResource SubHeaderStyle}" />
                                </StackLayout>
                                
                                <!-- Иконка погоды -->
                                <Image Grid.Row="0" Grid.Column="1"
                                       Source="{Binding Day.Condition.Icon, StringFormat='https:{0}'}"
                                       HeightRequest="40"
                                       WidthRequest="40"
                                       HorizontalOptions="End" />
                                
                                <!-- Условия погоды -->
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Day.Condition.Text}"
                                       Style="{StaticResource SubHeaderStyle}" />
                                
                                <!-- Температура и детали -->
                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                      ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                                    
                                    <!-- Максимальная температура -->
                                    <StackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Макс" Style="{StaticResource SubHeaderStyle}" Opacity="0.6" />
                                        <Label Text="{Binding Day.MaxTemp_C, StringFormat='{0:F0}°'}" 
                                               Style="{StaticResource TemperatureStyle}" />
                                    </StackLayout>
                                    
                                    <!-- Минимальная температура -->
                                    <StackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Мин" Style="{StaticResource SubHeaderStyle}" Opacity="0.6" />
                                        <Label Text="{Binding Day.MinTemp_C, StringFormat='{0:F0}°'}" 
                                               Style="{StaticResource TemperatureStyle}" />
                                    </StackLayout>
                                    
                                    <!-- Детали (ветер, влажность) -->
                                    <StackLayout Grid.Column="2" HorizontalOptions="End" Orientation="Horizontal" Spacing="12">
                                        <StackLayout Spacing="4">
                                            <Label Text="Ветер" Style="{StaticResource SubHeaderStyle}" Opacity="0.6" />
                                            <Label Text="{Binding Day.MaxWind_Kph, StringFormat='{0:F0} км/ч'}" 
                                                   Style="{StaticResource SubHeaderStyle}" />
                                        </StackLayout>
                                        
                                        <StackLayout Spacing="4">
                                            <Label Text="Влажность" Style="{StaticResource SubHeaderStyle}" Opacity="0.6" />
                                            <Label Text="{Binding Day.Avghumidity, StringFormat='{0:F0}%'}" 
                                                   Style="{StaticResource SubHeaderStyle}" />
                                        </StackLayout>
                                    </StackLayout>
                                </Grid>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </Grid>
</ContentPage> 