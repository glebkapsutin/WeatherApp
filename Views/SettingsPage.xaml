<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeatherAPP.ViewModels"
             x:Class="WeatherAPP.Views.SettingsPage"
             Title="Настройки">

    <ContentPage.BindingContext>
        <vm:SettingsViewModel/>
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <!-- О проекте -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                   CornerRadius="10"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="О проекте" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"/>
                    
                    <Label Text="WeatherAPP - современное погодное приложение, разработанное с использованием .NET MAUI. Приложение предоставляет актуальную информацию о погоде и прогноз на 7 дней для любого города мира."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                           LineBreakMode="WordWrap"/>
                    
                    <Label Text="{Binding AppVersion, StringFormat='Версия: {0}'}"
                           FontSize="16"/>
                    <Label Text="© 2024 WeatherAPP"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Внешний вид -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                   CornerRadius="10"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Внешний вид" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"/>
                    
                    <Label Text="Тема приложения" 
                           FontSize="16"/>
                    
                    <HorizontalStackLayout Spacing="15">
                        <RadioButton Content="Светлая" 
                                   IsChecked="{Binding IsDarkTheme, Converter={StaticResource InverseBoolConverter}}"
                                   GroupName="Theme"/>
                        <RadioButton Content="Темная" 
                                   IsChecked="{Binding IsDarkTheme}"
                                   GroupName="Theme"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Единицы измерения -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                   CornerRadius="10"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Единицы измерения" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"/>
                    
                    <Label Text="Температура" 
                           FontSize="16"/>
                    
                    <HorizontalStackLayout Spacing="15">
                        <RadioButton Content="Цельсий (°C)" 
                                   IsChecked="{Binding IsCelsius}"
                                   GroupName="Temperature"/>
                        <RadioButton Content="Фаренгейт (°F)" 
                                   IsChecked="{Binding IsFahrenheit}"
                                   GroupName="Temperature"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage> 